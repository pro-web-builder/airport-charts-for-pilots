// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------
// NOTE ON AUTH / FAVOURITES / HISTORY (v1 decision):
// There is no login in v1. Favourites and recent-search history live
// entirely in the browser via localStorage (see lib/favourites/useFavourites.ts
// and lib/history/useSearchHistory.ts) — no User table is needed for that.
//
// If accounts are introduced later, add:
//   model User          { id String @id @default(cuid()) email String @unique password String createdAt DateTime @default(now())
//                          favourites Favourite[] searchHistory SearchHistory[] }
//   model Favourite     { id String @id @default(cuid()) userId String airportId String createdAt DateTime @default(now())
//                          user User @relation(fields: [userId], references: [id], onDelete: Cascade)
//                          airport Airport @relation(fields: [airportId], references: [id], onDelete: Cascade)
//                          @@unique([userId, airportId]) }
//   model SearchHistory { id String @id @default(cuid()) userId String airportId String searchedAt DateTime @default(now())
//                          user User @relation(fields: [userId], references: [id], onDelete: Cascade)
//                          airport Airport @relation(fields: [airportId], references: [id], onDelete: Cascade) }
// Migration path: on first login, read the existing localStorage favourite/
// history arrays client-side and POST them once to a new /api/favourites/sync
// route to backfill the DB, then switch the hooks over to DB-backed reads/writes.
// -----------------------------------------------------------------------

enum ChartCategory {
  AIRPORT_DIAGRAM
  GROUND_CHART
  SID
  STAR
  ILS_APPROACH
  RNAV_APPROACH
  VOR_APPROACH
  VISUAL_APPROACH
  TAXI_CHART
  PARKING_CHART
}

model Airport {
  id          String   @id @default(cuid())
  icao        String   @unique @db.VarChar(4)
  iata        String?  @unique @db.VarChar(3)
  name        String
  city        String
  country     String
  countryCode String?
  region      String?
  latitude    Float
  longitude   Float
  elevationFt Int?
  timezone    String
  type        String?
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runways     Runway[]
  frequencies Frequency[]
  charts      Chart[]
  funFact     FunFact?

  @@index([name])
  @@index([city])
  @@index([country])
}

model Runway {
  id          String  @id @default(cuid())
  airportId   String
  airport     Airport @relation(fields: [airportId], references: [id], onDelete: Cascade)
  ident       String
  leIdent     String?
  heIdent     String?
  lengthFt    Int?
  widthFt     Int?
  surface     String?
  lighted     Boolean @default(true)
  headingDegT Float?

  @@index([airportId])
}

model Frequency {
  id           String  @id @default(cuid())
  airportId    String
  airport      Airport @relation(fields: [airportId], references: [id], onDelete: Cascade)
  type         String
  description  String?
  frequencyMhz Float

  @@index([airportId])
}

model Chart {
  id            String        @id @default(cuid())
  airportId     String
  airport       Airport       @relation(fields: [airportId], references: [id], onDelete: Cascade)
  category      ChartCategory
  title         String
  identifier    String?
  fileUrl       String
  revisionDate  DateTime?
  isPlaceholder Boolean       @default(true)
  createdAt     DateTime      @default(now())

  @@index([airportId, category])
}

// One-to-one, kept as its own model (not a scalar field on Airport) so it can
// later grow into multiple facts / sourcing metadata without a migration.
model FunFact {
  id        String  @id @default(cuid())
  airportId String  @unique
  airport   Airport @relation(fields: [airportId], references: [id], onDelete: Cascade)
  fact      String  @db.Text
}
